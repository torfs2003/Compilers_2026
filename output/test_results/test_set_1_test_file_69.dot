digraph AST {
  node [fontname="Arial"];
  node6 [label="ID: x\n(int)", shape=box, style="filled", fillcolor="lightgrey", color="black", fontcolor="black"];
  node7 [label="ID: y\n(int)", shape=box, style="filled", fillcolor="lightgrey", color="black", fontcolor="black"];
  node5 [label="*\n(int)", shape=circle, style="filled", fillcolor="none", color="black", fontcolor="black"];
  node5 -> node6 [style="solid", color="black"];
  node5 -> node7 [style="solid", color="black"];
  node4 [label="Return", shape=ellipse, style="filled", fillcolor="lightpink", color="black", fontcolor="black"];
  node4 -> node5 [style="solid", color="black"];
  node3 [label="Block", shape=diamond, style="filled", fillcolor="none", color="black", fontcolor="black"];
  node3 -> node4 [style="solid", color="black"];
  node2 [label="Func\nint some_func()", shape=invhouse, style="filled", fillcolor="lightgreen", color="black", fontcolor="black"];
  node2 -> node3 [style="solid", color="black"];
  node12 [label="5\n(int)", shape=box, style="filled", fillcolor="none", color="black", fontcolor="black"];
  node13 [label="1\n(int)", shape=box, style="filled", fillcolor="none", color="black", fontcolor="black"];
  node11 [label="Call: some_func()\n(int)", shape=ellipse, style="filled", fillcolor="lightpink", color="black", fontcolor="black"];
  node11 -> node12 [style="solid", color="black", label=" arg0", fontcolor="black"];
  node11 -> node13 [style="solid", color="black", label=" arg1", fontcolor="black"];
  node10 [label="Decl\nint\nx\n(int)", shape=box, style="filled", fillcolor="none", color="blue", fontcolor="black"];
  node10 -> node11 [style="solid", color="black", label=" init", fontcolor="blue"];
  node9 [label="Block", shape=diamond, style="filled", fillcolor="none", color="black", fontcolor="black"];
  node9 -> node10 [style="solid", color="black"];
  node8 [label="Func\nint main()", shape=invhouse, style="filled", fillcolor="lightgreen", color="black", fontcolor="black"];
  node8 -> node9 [style="solid", color="black"];
  node1 [label="Program", shape=box, style="filled", fillcolor="lightblue", color="black", fontcolor="black"];
  node1 -> node2 [style="solid", color="black"];
  node1 -> node8 [style="solid", color="black"];
}