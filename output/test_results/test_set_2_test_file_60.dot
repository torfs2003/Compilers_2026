digraph AST {
  node [fontname="Arial"];
  node4 [label="Continue", shape=box, style="filled", fillcolor="yellow", color="black", fontcolor="black"];
  node3 [label="Block", shape=diamond, style="filled", fillcolor="none", color="black", fontcolor="black"];
  node3 -> node4 [style="solid", color="black"];
  node2 [label="Func\nint main()", shape=invhouse, style="filled", fillcolor="lightgreen", color="black", fontcolor="black"];
  node2 -> node3 [style="solid", color="black"];
  node1 [label="Program", shape=box, style="filled", fillcolor="lightblue", color="black", fontcolor="black"];
  node1 -> node2 [style="solid", color="black"];
}